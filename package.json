{
  "name": "speedup-video-pro",
  "private": true,
  "version": "1.8.2",
  "description": "SpeedUp Video Pro — Chrome MV3 extension (version of record lives in public/manifest.json)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --dev --watch",
    "zip": "node scripts/build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "test:e2e": "npm run build && PW_EXPERIMENTAL_SERVICE_WORKER_NETWORK_EVENTS=1 playwright test",
    "test:coverage": "vitest run --coverage",
    "qa:live": "npm run build && PW_EXPERIMENTAL_SERVICE_WORKER_NETWORK_EVENTS=1 playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/chrome": "^0.0.293",
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.24.2",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
